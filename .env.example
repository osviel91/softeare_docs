# Server configuration (apps/api and apps/mcp).
#
# Copy to `.env` and fill in. Nothing here is needed for the local-first browser
# application or for the stdio MCP server: both run with no server at all.

# --- Required ---------------------------------------------------------------

# A libpq connection string. The server migrates this database at boot.
DATABASE_URL=postgres://sdm:change-me@localhost:5432/sdm

# Signs the login-state cookie and hashes session secrets. At least 32
# characters; generate one with `openssl rand -base64 48`.
COOKIE_SECRET=change-me-to-a-random-48-byte-secret

# The HMAC pepper agent credential digests are keyed with. At least 32
# characters; generate one with `openssl rand -base64 48`.
#
# Required in production, and deliberately independent of COOKIE_SECRET: one
# keys machine credentials, the other signs login state, so a leak of either
# must not compromise the other and the two should rotate separately.
TOKEN_PEPPER=change-me-to-a-different-random-48-byte-secret

# --- Identity provider (all three, or sign-in is disabled) -------------------

# The issuer, exactly as it appears in the `iss` claim.
OIDC_ISSUER=https://idp.example.com/realms/main
OIDC_CLIENT_ID=sequencediagrams
OIDC_CLIENT_SECRET=change-me
# Defaults to <PUBLIC_URL>/auth/callback and must match the provider's config.
# OIDC_REDIRECT_URI=https://docs.example.com/auth/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=https://docs.example.com/

# --- API host ---------------------------------------------------------------

# The externally visible base URL, used to build redirect URIs.
#
# It is also the origin a state-changing browser request must name (or match via
# `Sec-Fetch-Site`), so it must be the URL the browser actually visits — behind a
# proxy that is the proxy's public origin, not the API's internal address.
PUBLIC_URL=http://localhost:4000
HOST=0.0.0.0
PORT=4000

# Where user projects are stored. A volume in every deployment; never an image.
PROJECT_VOLUME=/data/projects

# Session lifetime in seconds (default: 14 days).
SESSION_TTL_SECONDS=1209600

# Set to "false" only when serving over plain HTTP on a trusted network.
# SECURE_COOKIES=true

# Development and test only: run PostgreSQL in-process (PGlite) instead of
# connecting to DATABASE_URL. Never use this in production.
# PGLITE_DIR=memory://

# Where users are sent after a successful login.
NODE_ENV=development

# --- MCP service (apps/mcp) -------------------------------------------------

# The canonical public URL of the MCP endpoint. This is the resource identity
# used in the `WWW-Authenticate` challenge and reserved for Phase 7's OAuth
# protected-resource metadata. It is never derived from a request's Host header.
MCP_PUBLIC_URL=http://localhost:4100
# MCP_PATH=/mcp

# Proxies whose X-Forwarded-* / Forwarded headers are believed. Anything else is
# ignored and the socket address is used instead. Empty means "trust nobody".
# Accepts exact addresses and IPv4 CIDR ranges.
TRUSTED_PROXIES=127.0.0.1

# Host header values the MCP endpoint will answer for. Empty means "do not
# check", which is right when the proxy is the only client.
# MCP_ALLOWED_HOSTS=mcp.docs.example.com

# Request and resource ceilings.
MCP_MAX_BODY_BYTES=1048576
MCP_MAX_SEQ_BYTES=1048576
MCP_MAX_EVENTSEQ_BYTES=1048576
MCP_MAX_MARKDOWN_BYTES=4194304

# Per-credential, per-class rate limits. Process-local: correct for a single MCP
# instance, and N times the budget across N instances. A deployment that scales
# out should inject a shared limiter (see apps/mcp/rate-limit.ts).
MCP_RATE_READ_LIMIT=600
MCP_RATE_READ_WINDOW_MS=60000
MCP_RATE_SEARCH_LIMIT=120
MCP_RATE_RENDER_LIMIT=60
MCP_RATE_WRITE_LIMIT=60
MCP_RATE_DELETE_LIMIT=10

# How long a tool may run before its work is aborted.
MCP_TOOL_TIMEOUT_MS=30000

# Prometheus text at /metrics. Keep it on the private network.
MCP_METRICS=true
