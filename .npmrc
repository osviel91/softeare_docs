# The shared user npm cache (/Users/usuario/.npm) is not writable in this
# environment, so keep the package cache inside the project. It is gitignored,
# so it never enters version control but makes installs reproducible here.
cache=./.npm-cache

# The esbuild postinstall script is gated by default; allow it so Vite works.
allow-scripts=true

registry=https://registry.npmjs.org/
